    "app:build": "tauri build",
    "app:portable": "tauri build --no-bundle && node scripts/portable.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "fast-xml-parser": "^5.11.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
