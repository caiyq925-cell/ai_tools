{
  "name": "devkit",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Alt+Space 唤起的开发者工具箱：时间转换 / JSON / XML / YAML / curl / MyBatis 日志",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
